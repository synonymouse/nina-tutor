---
import About from '../components/About.astro';
import Approach from '../components/Approach.astro';
import Contact from '../components/Contact.astro';
import ContactDialog from '../components/ContactDialog.astro';
import Hero from '../components/Hero.astro';
import MobileCta from '../components/MobileCta.astro';
import Offers from '../components/Offers.astro';
import Outcomes from '../components/Outcomes.astro';
import PrincipleFaq from '../components/PrincipleFaq.astro';
import Process from '../components/Process.astro';
import Recognition from '../components/Recognition.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <Hero />
    <Recognition />
    <Approach />
    <Outcomes />
    <About />
    <Process />
    <Offers />
    <PrincipleFaq />
    <Contact />
  </main>
  <ContactDialog />
  <MobileCta />
</BaseLayout>
